# Copy to .env for local overrides. Never commit .env.
RAPIDAPI_PROXY_SECRET=
# C2PA signing identity (scripts/make_signing_cert.py). Empty = throwaway dev identity.
SIGNING_CERT_PEM=
SIGNING_KEY_PEM=
# RFC 3161 timestamp authority. Use one in production (signatures outlive the certificate).
TSA_URL=http://timestamp.digicert.com
MAX_MEGAPIXELS=17
MAX_CONCURRENT_JOBS=1
